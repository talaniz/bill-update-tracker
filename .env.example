CONGRESS_API_KEY=
DATABASE_URL=postgresql://tracker:tracker@postgres:5432/bill_update_tracker
TRACKER_TIMEZONE=America/Los_Angeles
POLL_INTERVAL_SECONDS=3600
INITIAL_LOOKBACK_DAYS=0
TRACK_CURRENT_CONGRESS_ONLY=true
TARGET_CONGRESS=
ENABLE_SCHEDULER=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_HOST_BIND=0.0.0.0
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_SERVE_FROM_SUB_PATH=false
PROMETHEUS_RETENTION=30d
NTFY_HOST_BIND=127.0.0.1
NTFY_HOST_PORT=8093
NTFY_BASE_URL=http://localhost:8093
NTFY_AUTH_DEFAULT_ACCESS=deny-all
NTFY_AUTH_USERS=
NTFY_ENABLE_LOGIN=true
