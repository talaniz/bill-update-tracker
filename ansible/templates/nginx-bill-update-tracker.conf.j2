server {
    listen 80;
    listen [::]:80;
    server_name {{ app_public_host }};

    root {{ landing_root }};
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location = {{ app_public_path | regex_replace('/$', '') }} {
        return 301 {{ app_public_path }};
    }

    location ^~ {{ app_public_path }} {
        proxy_pass http://127.0.0.1:3000;
        proxy_redirect http://127.0.0.1:3000{{ app_public_path }} {{ app_public_path }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

{% if ntfy_enabled | bool %}
    location = {{ ntfy_public_path | regex_replace('/$', '') }} {
        return 301 {{ ntfy_public_path }};
    }

    location ^~ {{ ntfy_public_path }} {
        proxy_pass http://127.0.0.1:{{ ntfy_host_port }};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3m;
        proxy_send_timeout 3m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
{% endif %}
}
